# PSX daily circuit breaker % (apne broker/PSX notice se confirm karein)
PSX_CIRCUIT_PCT=7.5
# Is se kam average daily volume wale stocks par "LOW LIQUIDITY" warning aati hai
MIN_AVG_VOLUME=50000
# Python executable jo WhatsApp bot use kare (venv ho to full path dein)
PYTHON_PATH=python
# Dashboard sirf is computer par (127.0.0.1) ya poore network par (0.0.0.0)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# ===================================================================
# 🦅 EAGLE-EYE INSTANT PHONE & EMAIL NOTIFICATION SETTINGS
# ===================================================================

# 1. TELEGRAM PHONE ALERTS (Recommended - 100% Free, Instant Mobile Push)
# @BotFather se free bot banayein aur token yahan paste karein:
TELEGRAM_BOT_TOKEN=
# @userinfobot se apna Chat ID nikal kar yahan paste karein:
TELEGRAM_CHAT_ID=

# 2. EMAIL ALERTS (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
